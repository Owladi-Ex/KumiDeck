{
  "id": "/remote",
  "name": "KumiDeck — Papan Tombol",
  "short_name": "KumiDeck",
  "description": "Papan tombol jarak jauh KumiDeck: kendalikan desktop dengan ketukan dari ponsel atau tablet Anda.",
  "lang": "id",
  "dir": "ltr",
  "start_url": "/remote",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
